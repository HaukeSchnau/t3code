# This fork has no user account or T3 Connect authentication. Pairing a client
# with an environment remains the authorization boundary.

# Optional: override the iOS bundle identifier base for local signing.
# Development and preview builds append `.dev` and `.preview`.
# T3CODE_IOS_BUNDLE_IDENTIFIER_BASE=dev.example.t3code

# Optional: APNs gateway used by the signed iOS build. Local Xcode builds use
# sandbox automatically through the mobile scripts; distribution builds use
# production by default.
# T3CODE_APNS_ENVIRONMENT=sandbox

# APNs provider credentials used by the paired server for notifications and
# Live Activity updates. Create one Apple Push Notifications service key and
# configure either the file path or the inline PEM value, never both.
# T3CODE_APNS_TEAM_ID=ABC1234567
# T3CODE_APNS_KEY_ID=KEY1234567
# T3CODE_APNS_PRIVATE_KEY_FILE=/absolute/path/to/AuthKey_KEY1234567.p8
# T3CODE_APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.t3.codes; override to test against a staging deployment.
# T3CODE_HOSTED_APP_URL=https://nightly.app.t3.codes

# Public, ingest-only mobile OpenTelemetry configuration.
# T3CODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# T3CODE_MOBILE_OTLP_TRACES_DATASET=t3-code-mobile-traces-dev
# T3CODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
