{
  "schemaVersion": 2,
  "project": "t3code",
  "development": {
    "workloads": {
      "mobile": {},
      "web": {}
    },
    "endpoints": {
      "mobile": {
        "health": {
          "paths": ["/status"]
        }
      },
      "web": {
        "health": {
          "paths": ["/favicon.ico"]
        }
      }
    }
  },
  "release": {
    "package": "t3code",
    "executable": "t3",
    "action": "web",
    "health": {
      "paths": ["/"]
    }
  }
}
