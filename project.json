{
  "$schema": "https://raw.githubusercontent.com/HaukeSchnau/nix-infra-modules/main/schemas/project-descriptor/v2.json",
  "schemaVersion": 2,
  "project": "t3code",
  "development": {
    "workloads": {
      "mobile": {},
      "web": {}
    },
    "endpoints": {
      "mobile": {
        "health": {
          "paths": ["/status"]
        }
      },
      "web": {
        "health": {
          "paths": ["/"],
          "startupTimeoutSec": 300,
          "requestTimeoutSec": 300
        }
      }
    }
  },
  "release": {
    "package": "t3code",
    "executable": "t3",
    "action": "web",
    "health": {
      "paths": ["/"]
    }
  }
}
